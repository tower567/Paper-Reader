# Local Obsidian/Claudian extensions and session state.
.claudian/
.obsidian/plugins/
.obsidian/community-plugins.json

# Public-template safety: keep personal literature out of Git by default.
papers/*
!papers/.gitkeep
inbox/papers/*
!inbox/papers/.gitkeep
inbox/candidates/*
!inbox/candidates/.gitkeep
inbox/search-requests/*
!inbox/search-requests/.gitkeep
inbox/downloads/*
!inbox/downloads/.gitkeep
logs/search-history/*
!logs/search-history/.gitkeep

# Obsidian machine-specific workspace state.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
